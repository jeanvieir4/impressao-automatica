# Documentos processados pelo programa (dados de clientes - nunca versionar)
# "**/" cobre tambem copias rodadas de dentro de Para_Equipe ou outra pasta
**/Entrada/*
!**/Entrada/.gitkeep
**/Impresso/*
!**/Impresso/.gitkeep
**/Erro/*
!**/Erro/.gitkeep
**/Log/*
!**/Log/.gitkeep

# Arquivos temporarios do Office
~$*

# Backup local
*.bak

# Build outputs (gerados via ps2exe, nao versionados)
Impressao.exe
Impressao.exe.config
